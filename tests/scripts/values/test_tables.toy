//1-D table
{
	var table: Table = ["alpha": 1, "beta": 2, "gamma": 3];
	table["beta"] = 6;
	assert table == ["alpha": 1, "beta": 6, "gamma": 3], "1-D tables failed";
}

//nested
{
	var table: Table = [
		"outer": ["inner": true],
		"alpha": 1,
		"beta": 2,
		"gamma": 3
	];

	assert table == ["alpha": 1, "beta": 2, "gamma": 3, "outer": ["inner": true]], "nested tables failed";
}

//syntax
{
	var empty = [:];
	assert empty.length == 0, "Empty table failed";

	var trailing = [
		"alpha":1,
		"beta":2,
		"gamma":3,
	];

	assert trailing == ["alpha": 1, "beta": 2, "gamma": 3], "Trailing comma table failed";

	var nested = [
		"grass": ["bulbasaur": 1, "ivysaur": 2, "venusaur": 3,],
		"fire": ["charmander": 4, "charmelion": 5, "charizard": 6,],
		"water": ["squirtle": 7, "wartortle": 8, "blastoise": 9,],
	];

	assert nested.length == 3, "Nested tables with trailing commas length failed";
	assert nested == [ "grass": ["bulbasaur": 1, "ivysaur": 2, "venusaur": 3], "fire": ["charmander": 4, "charmelion": 5, "charizard": 6], "water": ["squirtle": 7, "wartortle": 8, "blastoise": 9] ], "Nested tables with trailing commas failed";
}

 