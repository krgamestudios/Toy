//comparator
fn less(a, b) { return a - b; }

fn validate(arr) {
	var prev = arr[0];
	for (var i = 0; i < arr.length; i++) {
		assert prev <= arr[i], "Quicksort validation failed";
		prev = arr[i];
	}
}

{
	//ordered
	var a1 = [
		1, 2, 3, 4, 5
	];
	a1.sort(less);
	print a1;
	validate(a1);


	//reversed
	var a2 = [
		5,4,3,2,1
	];
	a2.sort(less);
	print a2;
	validate(a2);
}

